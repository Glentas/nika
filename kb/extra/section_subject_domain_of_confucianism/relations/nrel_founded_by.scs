/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_founded_by - относительное понятие «основано*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_founded_by
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[основано*]
	(* <- lang_ru;; *);
	[founded by*]
	(* <- lang_en;; *);
=> nrel_note:
	[Отношение задано от направления к мыслителю, а не наоборот: одно направление может быть
	основано несколькими мыслителями (например, школа Лу - Ван основана Лу Цзююанем и
	завершена Ван Янмином), тогда как у мыслителя может быть несколько
	направлений-преемников.]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_school;
=> nrel_second_domain: concept_confucian_thinker;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_school;
				concept_confucian_thinker
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (основано*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Основано* - бинарное ориентированное отношение, связывающее направление
					конфуцианства и конфуцианского мыслителя, проповедь которого положила
					начало этому направлению.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_school;
				concept_confucian_thinker
			};;
	*);;

