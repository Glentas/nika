/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_associated_with_state - относительное понятие «связан с государством*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_associated_with_state
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[связан с государством*]
	(* <- lang_ru;; *);
	[associated with state*]
	(* <- lang_en;; *);
=> nrel_note:
	[Отношение фиксирует место происхождения и служения: Конфуций связан с царством Лу,
	Сюнь-цзы - с царствами Чжао и Ци, Мэн-цзы странствовал по Ци, Лян и Вэй.]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_person_of_east_asian_tradition;
=> nrel_second_domain: concept_historical_state;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_person_of_east_asian_tradition;
				concept_historical_state
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (связан с государством*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Связан с государством* - бинарное ориентированное отношение, связывающее
					деятеля конфуцианской традиции и государство, в котором он родился,
					служил либо вёл проповедь.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_person_of_east_asian_tradition;
				concept_historical_state
			};;
	*);;

