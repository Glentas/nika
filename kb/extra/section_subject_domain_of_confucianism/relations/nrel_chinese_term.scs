/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_chinese_term - относительное понятие «китайский термин*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_chinese_term
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[китайский термин*]
	(* <- lang_ru;; *);
	[Chinese term*]
	(* <- lang_en;; *);
=> nrel_note:
	[Отношение введено дополнительно к nrel_idtf, чтобы термины оригинала можно было
	запрашивать отдельно от переводных идентификаторов и чтобы один термин иероглифического
	письма мог соответствовать нескольким понятиям (иероглиф 礼 означает и добродетель ли, и
	ритуал ли).]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_concept;
=> nrel_second_domain: concept_chinese_term;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_concept;
				concept_chinese_term
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (китайский термин*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Китайский термин* - бинарное ориентированное отношение, связывающее
					понятие конфуцианской традиции и его обозначение средствами китайского
					письма.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_concept;
				concept_chinese_term
			};;
	*);;

