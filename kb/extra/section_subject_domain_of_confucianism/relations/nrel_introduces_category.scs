/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_introduces_category - относительное понятие «вводит понятие*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_introduces_category
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[вводит понятие*]
	(* <- lang_ru;; *);
	[introduces concept*]
	(* <- lang_en;; *);
=> nrel_note:
	[Позволяет отвечать на вопросы вида «где встречается жэнь?» и «какие понятия вводит „Чжун
	юн“?».]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_text;
=> nrel_second_domain: concept_confucian_concept;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_text;
				concept_confucian_concept
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (вводит понятие*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Вводит понятие* - бинарное ориентированное отношение, связывающее
					конфуцианский текст и понятие конфуцианской традиции, впервые либо
					наиболее полно раскрытое в этом тексте.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_text;
				concept_confucian_concept
			};;
	*);;

