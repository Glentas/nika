/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_spread_in - относительное понятие «распространено*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_spread_in
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[распространено*]
	(* <- lang_ru;; *);
	[spread in*]
	(* <- lang_en;; *);
=> nrel_note:
	[Первый домен задан широко (философское учение), поэтому отношением можно связать и
	конфуцианство, и буддизм, и легизм, что полезно для сравнительных вопросов в следующих
	лабораторных работах.]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_philosophical_teaching;
=> nrel_second_domain: concept_historical_state;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_philosophical_teaching;
				concept_historical_state
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (распространено*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Распространено* - бинарное ориентированное отношение, связывающее
					философское учение и государство, в котором это учение получило
					устойчивое распространение.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_philosophical_teaching;
				concept_historical_state
			};;
	*);;

