/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_located_in - относительное понятие «расположено*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_located_in
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[расположено*]
	(* <- lang_ru;; *);
	[located in*]
	(* <- lang_en;; *);
=> nrel_note:
	[Связывает конфуцианские институты с государствами: академия Юэлу - с императорским
	Китаем, Сонгюнгван - с Кореей Чосон, Юсима сэйдо - с Японией Токугава.]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_institution;
=> nrel_second_domain: concept_historical_state;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_institution;
				concept_historical_state
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (расположено*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Расположено* - бинарное ориентированное отношение, связывающее
					конфуцианский институт и государство, на территории которого этот
					институт действовал.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_institution;
				concept_historical_state
			};;
	*);;

