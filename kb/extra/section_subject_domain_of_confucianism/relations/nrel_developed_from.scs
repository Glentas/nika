/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_developed_from - относительное понятие «является развитием*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_developed_from
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[является развитием*]
	(* <- lang_ru;; *);
	[developed from*]
	(* <- lang_en;; *);
=> nrel_note:
	[Фиксирует преемственность направлений, в том числе через эпохи и страны: учение Чжу Си
	является развитием школы братьев Чэн, учение Хаяси Радзана - развитием учения Чжу Си.]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_school;
=> nrel_second_domain: concept_confucian_school;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_school;
				concept_confucian_school
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (является развитием*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Является развитием* - бинарное ориентированное отношение, связывающее
					направление конфуцианства и то более раннее направление, преемником и
					развитием которого оно выступает.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_school;
				concept_confucian_school
			};;
	*);;

