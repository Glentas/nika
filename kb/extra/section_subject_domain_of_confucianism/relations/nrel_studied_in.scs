/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_studied_in - относительное понятие «изучается в учебном заведении*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_studied_in
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[изучается в учебном заведении*]
	(* <- lang_ru;; *);
	[studied in*]
	(* <- lang_en;; *);
=> nrel_note:
	[Демонстрирует институциональное измерение учения: Четырёхкнижие изучалось в Гоцзыцзяне и
	в академии Юэлу, каноны - в корейском Сонгюнгване.]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_text;
=> nrel_second_domain: concept_confucian_educational_institution;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_text;
				concept_confucian_educational_institution
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (изучается в учебном заведении*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Изучается в учебном заведении* - бинарное ориентированное отношение,
					связывающее конфуцианский текст и учебное заведение, в котором этот
					текст входил в курс обучения.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_text;
				concept_confucian_educational_institution
			};;
	*);;

