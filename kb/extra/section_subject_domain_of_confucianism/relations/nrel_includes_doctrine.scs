/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_includes_doctrine - относительное понятие «включает положение учения*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_includes_doctrine
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[включает положение учения*]
	(* <- lang_ru;; *);
	[includes doctrine*]
	(* <- lang_en;; *);
=> nrel_note:
	[Отношение фиксирует содержательный состав направления и позволяет строить цепочки вида
	«учение Ван Янмина - единство знания и действия - врождённое знание».]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_school;
=> nrel_second_domain: concept_confucian_principle_doctrine;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_school;
				concept_confucian_principle_doctrine
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (включает положение учения*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Включает положение учения* - бинарное ориентированное отношение,
					связывающее направление конфуцианства и положение, разделяемое этим
					направлением.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_school;
				concept_confucian_principle_doctrine
			};;
	*);;

