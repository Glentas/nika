/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   nrel_used_in_examination - относительное понятие «используется на имперском экзамене*».
   Фактический слой - по открытым энциклопедическим источникам. */

nrel_used_in_examination
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
=> nrel_main_idtf:
	[используется на имперском экзамене*]
	(* <- lang_ru;; *);
	[used in imperial examination*]
	(* <- lang_en;; *);
=> nrel_note:
	[Программа кэцзюй с 1313 г. опиралась на Четырёхкнижие в толковании Чжу Си, поэтому
	отношение связывает тексты с экзаменами минъюань, сюцай, цзюйжэнь и цзиньши.]
	(* <- lang_ru;; *);
=> nrel_first_domain: concept_confucian_text;
=> nrel_second_domain: concept_imperial_examination;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_confucian_text;
				concept_imperial_examination
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (используется на имперском экзамене*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Используется на имперском экзамене* - бинарное ориентированное
					отношение, связывающее конфуцианский текст и ступень имперского
					экзамена, для которой этот текст входил в программу.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_text;
				concept_imperial_examination
			};;
	*);;

