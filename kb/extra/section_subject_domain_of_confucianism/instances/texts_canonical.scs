<- concept_confucian_text;
<- concept_confucian_canonical_book;
=> nrel_main_idtf:
	[«Чжоу ли»]
	(* <- lang_ru;; *);
	[Rites of Zhou]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Ритуалы Чжоу]
	(* <- lang_ru;; *);
	[Чжоу гуань]
	(* <- lang_ru;; *);
=> nrel_note:
	[Описание идеальной чиновной системы Чжоу из шести ведомств. Стало основой конфуцианской
	программы государственного устройства.]
	(* <- lang_ru;; *);
=> nrel_commented_by:
	zheng_xuan;
=> nrel_introduces_category:
	li_ritual;
	ritual_sacrifice_to_heaven;
=> nrel_part_of_canon:
	thirteen_classics;
=> nrel_studied_in:
	guozijian;;

ceremonial_ritual
<- concept_confucian_text;
<- concept_confucian_canonical_book;
=> nrel_main_idtf:
	[«И ли»]
	(* <- lang_ru;; *);
	[Ceremonial and Ritual]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Церемонии и ритуалы]
	(* <- lang_ru;; *);
=> nrel_note:
	[Древнейший из ритуальных канонов: пошаговые описания церемоний - возложения шапки,
	свадьбы, похорон, приёма гостей, стрельбы из лука.]
	(* <- lang_ru;; *);
=> nrel_commented_by:
	zheng_xuan;
=> nrel_introduces_category:
	ritual_capping;
	ritual_marriage;
	ritual_funeral;
	ritual_archery;
=> nrel_part_of_canon:
	thirteen_classics;
=> nrel_studied_in:
	guozijian;;

classic_of_filial_piety
<- concept_confucian_text;
<- concept_confucian_canonical_book;
=> nrel_main_idtf:
	[«Сяо цзин»]
	(* <- lang_ru;; *);
	[Classic of Filial Piety]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Канон сыновней почтительности]
	(* <- lang_ru;; *);
=> nrel_note:
	[Небольшой канон в 18 главах в форме беседы Конфуция с Цзэн-цзы о сяо. В эпоху Тан по
	указу императора Сюань-цзуна (733 г.) изучался во всех школах как первый учебный текст.]
	(* <- lang_ru;; *);
=> nrel_authored:
	zengzi;
