zhou_dunyi
<- concept_confucian_thinker;
<- concept_confucian_official;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
=> nrel_main_idtf:
	[Чжоу Дуньи]
	(* <- lang_ru;; *);
	[Zhou Dunyi]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Чжоу Ляньси]
	(* <- lang_ru;; *);
	[Чжоу Маошу]
	(* <- lang_ru;; *);
=> nrel_note:
	[Чжоу Дуньи (1017-1073) из Даочжоу; в 1063 г. составил «Тайцзи ту шу» - пояснение к
	космологической схеме, ставшее фундаментом неоконфуцианской метафизики. Наставник
	братьев Чэн.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_influenced:
	cheng_hao;
	cheng_yi;
	zhang_zai;
	zhu_xi;
=> nrel_lived_in_period:
	dynasty_song;
=> nrel_teacher_of:
	cheng_hao;
	cheng_yi;;

zhang_zai
<- concept_confucian_thinker;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
=> nrel_main_idtf:
	[Чжан Цзай]
	(* <- lang_ru;; *);
	[Zhang Zai]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Чжан Хэнцюй]
	(* <- lang_ru;; *);
=> nrel_note:
	[Чжан Цзай (1020-1077) построил космологию на ци (материальной силе), рассматривая все
	вещи как её сгущения и рассеяния. В «Си мин» провозгласил: «Небо - мой отец, земля - моя
	мать... все люди - мои братья, все вещи - мои спутники». Ему принадлежат «четыре цели»:
	установить сердце для Неба и земли, установить жизнь для народа, продолжить прерванное
	учение, открыть мир для десяти тысяч поколений.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_influenced:
	zhu_xi;
	wang_fuzhi;
=> nrel_lived_in_period:
	dynasty_song;;

cheng_hao
<- concept_confucian_thinker;
<- concept_confucian_official;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
=> nrel_main_idtf:
	[Чэн Хао]
	(* <- lang_ru;; *);
	[Cheng Hao]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Чэн Миндао]
	(* <- lang_ru;; *);
=> nrel_note:
	[Чэн Хао (1032-1085), старший из братьев Чэн, уроженец Лояна. Развивал идею
	«человеколюбия как единого тела со всеми вещами» и считал, что принцип присутствует в
	сердце непосредственно.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_influenced:
	zhu_xi;
	lu_jiuyuan;
=> nrel_lived_in_period:
	dynasty_song;
=> nrel_teacher_of:
	yang_shi;;

cheng_yi
<- concept_confucian_thinker;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
=> nrel_main_idtf:
	[Чэн И]
	(* <- lang_ru;; *);
	[Cheng Yi]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Чэн Ичуань]
	(* <- lang_ru;; *);
=> nrel_note:
	[Чэн И (1033-1107), младший брат Чэн Хао, настаивал на исследовании вещей как пути
	познания принципа и на «почтительной собранности» (цзин) как способе управления сердцем.
	Его комментарий к «И цзину» стал образцом философского толкования канона.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_influenced:
	zhu_xi;
=> nrel_lived_in_period:
	dynasty_song;
=> nrel_teacher_of:
	yang_shi;;

yang_shi
<- concept_confucian_thinker;
<- concept_confucian_disciple;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
=> nrel_main_idtf:
	[Ян Ши]
	(* <- lang_ru;; *);
	[Yang Shi]
	(* <- lang_en;; *);
=> nrel_note:
	[Ян Ши (1053-1135) - ученик братьев Чэн, перенёс их учение на юг. Предание «снег по
	колено у дверей Чэн» (чэн мэнь ли сюэ) описывает, как он стоял на снегу, ожидая
	окончания беседы учителя, и передаёт идеал почтительности ученика.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_influenced:
	zhu_xi;
=> nrel_lived_in_period:
	dynasty_song;
=> nrel_teacher_of:
	luo_congyan;;

