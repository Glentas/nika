	(* <- lang_en;; *);
=> nrel_note:
	[Люй Цзуцянь (1137-1181) - историк и глава школы Цзиньхуа, в 1175 г. организовал встречу
	у озера Эху, где спорили Чжу Си и Лу Цзююань; вместе с Чжу Си составил антологию «Цзинь
	сы лу».]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_lived_in_period:
	dynasty_song;;

zhu_xi
<- concept_confucian_thinker;
<- concept_confucian_official;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Чжу Си]
	(* <- lang_ru;; *);
	[Zhu Xi]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Чжу Юаньхуэй]
	(* <- lang_ru;; *);
	[Чжу Чжунхуэй]
	(* <- lang_ru;; *);
=> nrel_note:
	[Чжу Си (1130-1200) - крупнейший систематизатор неоконфуцианства. Свёл Четырёхкнижие в
	единый канон с собственными комментариями (1190 г.), возродил академию Байлудун и
	составил для неё устав, читал лекции в академии Юэлу (1167, 1194 гг.). Занимал
	должности, в том числе служил при дворе, но большей частью преподавал.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_influenced:
	yi_hwang;
	yi_i;
	hayashi_razan;
	wang_yangming;
=> nrel_lived_in_period:
	dynasty_song;;

