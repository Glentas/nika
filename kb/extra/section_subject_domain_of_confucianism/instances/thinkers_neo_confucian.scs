	[Лу Цзююань]
	(* <- lang_ru;; *);
	[Lu Jiuyuan]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Лу Сяншань]
	(* <- lang_ru;; *);
=> nrel_note:
	[Лу Цзююань (1139-1193) - основатель «учения о сердце». Его формула «сердце и есть
	принцип» и требование «сначала встать на ноги» противопоставлялись чжусианскому
	«исследованию вещей». Спор 1175 г. на озере Эху закрепил разделение неоконфуцианства на
	две ветви.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	empire_china;
=> nrel_influenced:
	yang_jian;
	wang_yangming;
=> nrel_lived_in_period:
	dynasty_song;
=> nrel_teacher_of:
