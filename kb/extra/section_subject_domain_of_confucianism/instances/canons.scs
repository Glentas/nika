/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   Экземпляры: Канонические собрания.
   Фактический слой - по открытым энциклопедическим источникам. */

five_classics
<- concept_confucian_canon;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Пятикнижие]
	(* <- lang_ru;; *);
	[Five Classics]
	(* <- lang_en;; *);
=> nrel_idtf:
	[у цзин]
	(* <- lang_ru;; *);
=> nrel_note:
	[Пять канонов (И цзин, Шу цзин, Ши цзин, Ли цзи, Чуньцю), получивших государственный
	статус при Хань. Первоначально речь шла о «шести искусствах» (лю и), куда входил
	утраченный канон музыки «Юэ цзин».]
	(* <- lang_ru;; *);;

four_books
<- concept_confucian_canon;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Четырёхкнижие]
	(* <- lang_ru;; *);
	[Four Books]
	(* <- lang_en;; *);
=> nrel_idtf:
	[сы шу]
	(* <- lang_ru;; *);
=> nrel_note:
	[Состав Чжу Си (1190 г.): «Лунь юй», «Мэн-цзы», «Да сюэ», «Чжун юн». С 1313 г. - основная
	экзаменационная программа кэцзюй в толковании Чжу Си.]
	(* <- lang_ru;; *);;

thirteen_classics
<- concept_confucian_canon;
=> nrel_main_idtf:
	[Тринадцатикнижие]
	(* <- lang_ru;; *);
	[Thirteen Classics]
	(* <- lang_en;; *);
=> nrel_idtf:
	[ши сань цзин]
	(* <- lang_ru;; *);
=> nrel_note:
	[Расширенный канон, сложившийся к эпохе Сун: к Пятикнижию добавлены «Чжоу ли», «И ли»,
	«Сяо цзин», «Лунь юй», «Эръя», «Мэн-цзы» и комментарии к «Чуньцю» («Гунъян чжуань»,
	«Гулян чжуань», «Цзо чжуань»). В 1150-х гг. был издан полный свод.]
	(* <- lang_ru;; *);;

