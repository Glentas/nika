	(* <- lang_ru;; *);
=> nrel_note:
	[Чжоу Дуньи считается родоначальником неоконфуцианства: в «Тайцзи ту шу» он вывел
	космологию из схемы Великого предела, совместив её с конфуцианской этикой и заимствовав
	форму у даосской космогонии.]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_confucius;
=> nrel_founded_by:
	zhou_dunyi;
=> nrel_includes_doctrine:
	principle_is_fundamental;
=> nrel_promotes_virtue:
	cheng_sincerity;
	ren;
=> nrel_represented_by:
	cheng_hao;
	cheng_yi;
=> nrel_spread_in:
	empire_china;;

school_cheng_brothers
<- concept_confucianism;
<- concept_confucian_school;
<- concept_neo_confucianism;
<- concept_cheng_zhu_school;
=> nrel_main_idtf:
	[школа братьев Чэн]
	(* <- lang_ru;; *);
	[school of the Cheng brothers]
	(* <- lang_en;; *);
=> nrel_idtf:
	[ло сюэ]
	(* <- lang_ru;; *);
	[луосская школа]
	(* <- lang_ru;; *);
=> nrel_note:
	[Чэн Хао и Чэн И, уроженцы Лояна, ввели понятие ли (принцип) в центр конфуцианской
	метафизики и связали путь учения с «почтительной собранностью» (цзин) и «исследованием
	вещей» (гэ у). Чэн И прямо формулировал тезис «принцип един, а его проявления различны».]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_lian_xue;
=> nrel_founded_by:
	cheng_hao;
	cheng_yi;
=> nrel_includes_doctrine:
	principle_is_fundamental;
	ge_wu;
=> nrel_opposed_to:
	teaching_chan;
=> nrel_promotes_virtue:
	ren;
	jing_reverence;
=> nrel_represented_by:
	yang_shi;
	zhu_xi;
=> nrel_spread_in:
	empire_china;;

school_zhu_xi
<- concept_confucianism;
<- concept_confucian_school;
<- concept_neo_confucianism;
<- concept_cheng_zhu_school;
<- concept_wit_entity;
=> nrel_main_idtf:
	[учение Чжу Си]
	(* <- lang_ru;; *);
	[teaching of Zhu Xi]
	(* <- lang_en;; *);
=> nrel_idtf:
	[ли сюэ]
	(* <- lang_ru;; *);
	[учение о принципе]
	(* <- lang_ru;; *);
	[школа Чэн - Чжу]
	(* <- lang_ru;; *);
=> nrel_note:
	[Чжу Си синтезировал идеи Чжоу Дуньи, Чжан Цзая и братьев Чэн и закрепил канон
	Четырёхкнижия собственными комментариями (1190 г.). С 1313 г. его толкования стали
	обязательной программой имперских экзаменов и оставались официальной ортодоксией до
	отмены кэцзюй в 1905 г.]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_cheng_brothers;
=> nrel_founded_by:
	zhu_xi;
=> nrel_includes_doctrine:
