=> nrel_opposed_to:
	school_lu_xiangshan;
	teaching_chan;
	school_wang_yangming;
=> nrel_promotes_virtue:
	ren;
	li_ritual;
	zhi_wisdom;
	jing_reverence;
=> nrel_represented_by:
	zhu_xi;
	lu_zuqian;
=> nrel_spread_in:
	empire_china;
	joseon_korea;
	tokugawa_japan;
	dai_viet;;

school_lu_xiangshan
<- concept_confucianism;
<- concept_confucian_school;
<- concept_neo_confucianism;
<- concept_lu_wang_school;
=> nrel_main_idtf:
	[учение Лу Цзююаня]
	(* <- lang_ru;; *);
	[teaching of Lu Jiuyuan]
	(* <- lang_en;; *);
=> nrel_idtf:
	[синь сюэ]
	(* <- lang_ru;; *);
	[учение о сердце]
	(* <- lang_ru;; *);
	[школа Сяншань]
	(* <- lang_ru;; *);
=> nrel_note:
	[Лу Цзююань утверждал «сердце и есть принцип» (синь цзи ли) и считал излишним
	многословное исследование вещей. В 1175 г. на встрече у озера Эху он спорил с Чжу Си о
	методе учения; спор зафиксирован как событие, разделившее неоконфуцианство на две ветви.]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_cheng_brothers;
=> nrel_founded_by:
	lu_jiuyuan;
