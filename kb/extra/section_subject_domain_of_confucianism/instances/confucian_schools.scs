/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   Экземпляры: Направления (школы) конфуцианства - экземпляры максимального класса.
   Фактический слой - по открытым энциклопедическим источникам. */

school_confucius
<- concept_confucianism;
<- concept_confucian_school;
<- concept_early_confucianism;
<- concept_philosophical_teaching;
<- concept_wit_entity;
=> nrel_main_idtf:
	[учение Конфуция]
	(* <- lang_ru;; *);
	[teaching of Confucius]
	(* <- lang_en;; *);
=> nrel_idtf:
	[жу цзя]
	(* <- lang_ru;; *);
	[школа книжников]
	(* <- lang_ru;; *);
	[конфуцианская ортодоксия]
	(* <- lang_ru;; *);
=> nrel_note:
	[Исходная форма конфуцианства: учение изложено не самим Конфуцием в виде трактата, а в
	записи его бесед («Лунь юй»), составленной учениками и последователями учеников. В «Ши
	цзи» Сыма Цянь говорится о трёх тысячах учеников, из которых семьдесят два «преуспели в
	шести искусствах».]
	(* <- lang_ru;; *);
=> nrel_founded_by:
	confucius;
=> nrel_includes_doctrine:
	golden_rule;
	rectification_of_names;
	doctrine_of_the_mean;
	mandate_of_heaven;
	three_guides_eight_steps;
=> nrel_opposed_to:
	teaching_mo_di;
	teaching_laozi;
	teaching_han_fei;
	teaching_zhuangzi;
	teaching_chan;
	teaching_shang_yang;
=> nrel_promotes_virtue:
	ren;
	li_ritual;
	yi;
	zhi_wisdom;
	xiao;
	shu_reciprocity;
	zhong_loyalty;
	wen_culture;
=> nrel_represented_by:
	yan_hui;
	zi_gong;
	zi_lu;
	zi_xia;
	zengzi;
	zisi;
	you_ruo;
	ran_qiu;
=> nrel_spread_in:
	state_lu;
	state_qi;
	empire_china;;

school_mencius
<- concept_confucianism;
<- concept_confucian_school;
<- concept_early_confucianism;
<- concept_wit_entity;
=> nrel_main_idtf:
	[учение Мэн-цзы]
	(* <- lang_ru;; *);
	[teaching of Mencius]
	(* <- lang_en;; *);
=> nrel_idtf:
	[мэн сюэ]
	(* <- lang_ru;; *);
=> nrel_note:
	[Мэн-цзы развил линию Конфуция, доказывая врождённость добра в человеческой природе через
	«четыре начала» (сы дуань): сострадание, стыд, уступчивость и различение правильного и
	неправильного. Отсюда следует и политический тезис о праве народа свергнуть правителя,
	утратившего мандат Неба.]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_confucius;
=> nrel_founded_by:
	mencius;
=> nrel_includes_doctrine:
	innate_goodness_of_nature;
	mandate_of_heaven;
=> nrel_opposed_to:
	teaching_mo_di;
	school_xunzi;
	teaching_han_fei;
=> nrel_promotes_virtue:
	ren;
	yi;
	zhi_wisdom;
=> nrel_spread_in:
	state_zou;
	state_qi;
	empire_china;;

school_xunzi
<- concept_confucianism;
<- concept_confucian_school;
<- concept_early_confucianism;
<- concept_wit_entity;
=> nrel_main_idtf:
	[учение Сюнь-цзы]
	(* <- lang_ru;; *);
	[teaching of Xunzi]
	(* <- lang_en;; *);
=> nrel_idtf:
	[сюнь сюэ]
	(* <- lang_ru;; *);
=> nrel_note:
	[Сюнь-цзы утверждал, что природа человека порочна (син э), а добро есть результат
	воспитания, обучения и ритуала. Эта позиция сблизила конфуцианство с легизмом: его
	ученики Хань Фэй и Ли Сы стали теоретиками и практиками циньского легизма.]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_confucius;
=> nrel_founded_by:
	xunzi;
=> nrel_includes_doctrine:
	innate_evil_of_nature;
	rectification_of_names;
=> nrel_opposed_to:
	school_mencius;
=> nrel_promotes_virtue:
	li_ritual;
	yi;
	zhi_wisdom;
=> nrel_spread_in:
	state_zhao;
	state_qi;
	state_chu;
	empire_china;;

school_dong_zhongshu
<- concept_confucianism;
<- concept_confucian_school;
<- concept_han_confucianism;
<- concept_wit_entity;
=> nrel_main_idtf:
	[учение Дун Чжуншу]
	(* <- lang_ru;; *);
	[teaching of Dong Zhongshu]
	(* <- lang_en;; *);
=> nrel_idtf:
	[ханьское конфуцианство]
	(* <- lang_ru;; *);
=> nrel_note:
	[В 134 г. до н. э. Дун Чжуншу подал императору У-ди три доклада («Тянь жэнь сань цэ»),
	предложив почитать только «шесть искусств и учение Конфуция» и запретить остальные
	школы. Это привело к учреждению императорской академии (124 г. до н. э.) и к превращению
	конфуцианства в государственную идеологию.]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_confucius;
=> nrel_founded_by:
	dong_zhongshu;
=> nrel_includes_doctrine:
	three_principles_and_five_constants;
	interaction_of_heaven_and_human;
	mandate_of_heaven;
=> nrel_opposed_to:
	teaching_han_fei;
	teaching_mo_di;
=> nrel_promotes_virtue:
	ren;
	yi;
	li_ritual;
	zhi_wisdom;
	xin_trust;
	zhong_loyalty;
=> nrel_spread_in:
	empire_china;;

school_lian_xue
<- concept_confucianism;
<- concept_confucian_school;
