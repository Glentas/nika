	(* <- lang_ru;; *);
=> nrel_note:
	[Ван Янмин сформулировал «единство знания и действия» (чжи син хэ и) и учение о
	«врождённом знании» (лян чжи), которое нужно лишь «распространять» (чжи лян чжи). Он был
	не только философом, но и полководцем, подавившим мятеж князя Чэнь Хао в 1519 г.]
	(* <- lang_ru;; *);
=> nrel_developed_from:
	school_lu_xiangshan;
=> nrel_founded_by:
	wang_yangming;
