/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   Экземпляры: Китайские термины.
   Фактический слой - по открытым энциклопедическим источникам. */

term_ren
<- concept_chinese_term;
=> nrel_main_idtf:
	[仁 (жэнь)]
	(* <- lang_ru;; *);
	[ren]
	(* <- lang_en;; *);
=> nrel_note:
	[Пиньинь ren. Иероглиф сочетает знаки «человек» и «два», что традиционно толкуют как
	«человек по отношению к другому человеку». Переводы: человеколюбие, гуманность,
	человечность.]
	(* <- lang_ru;; *);;

term_yi
<- concept_chinese_term;
=> nrel_main_idtf:
	[義 (и)]
	(* <- lang_ru;; *);
	[yi]
	(* <- lang_en;; *);
=> nrel_note:
	[Пиньинь yi, упрощённое написание 义. Переводы: справедливость, долг, должное.]
	(* <- lang_ru;; *);;

term_li_ritual
<- concept_chinese_term;
=> nrel_main_idtf:
	[禮 (ли)]
	(* <- lang_ru;; *);
	[li]
	(* <- lang_en;; *);
=> nrel_note:
	[Пиньинь li, упрощённое написание 礼. Означает и ритуал, и норму поведения, и
	благопристойность. Омонимичен термину 理 (принцип), что постоянно создаёт трудности
	перевода.]
	(* <- lang_ru;; *);;

term_zhi
<- concept_chinese_term;
=> nrel_main_idtf:
	[智 (чжи)]
	(* <- lang_ru;; *);
	[zhi]
	(* <- lang_en;; *);
=> nrel_note:
	[Пиньинь zhi. Мудрость, знание, способность различать.]
	(* <- lang_ru;; *);;

term_xin_trust
<- concept_chinese_term;
=> nrel_main_idtf:
	[信 (синь)]
	(* <- lang_ru;; *);
	[xin]
	(* <- lang_en;; *);
=> nrel_note:
	[Пиньинь xin. Благонадёжность, верность слову. Знак состоит из элементов «человек» и
	«слово».]
	(* <- lang_ru;; *);;

