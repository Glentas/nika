=> nrel_main_idtf:
	[恕 (шу)]
	(* <- lang_ru;; *);
	[shu]
	(* <- lang_en;; *);
=> nrel_note:
	[Пиньинь shu. Взаимность, снисходительность; знак построен на элементах «как» и «сердце»,
	то есть «поступать с другими как с собой».]
	(* <- lang_ru;; *);;

