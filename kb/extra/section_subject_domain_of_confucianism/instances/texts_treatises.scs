da_tong_shu
<- concept_confucian_text;
<- concept_confucian_treatise;
=> nrel_main_idtf:
	[«Да тун шу»]
	(* <- lang_ru;; *);
	[Book of Great Unity]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Книга о великом единстве]
	(* <- lang_ru;; *);
=> nrel_note:
	[Утопическое сочинение Кан Ювэя, завершённое к 1902 г. и изданное в 1935 г. Опирается на
	образ «великого единства» из канона «Ли цзи», но дополняет его идеями равенства полов,
	отмены государств и всеобщего общественного воспитания.]
	(* <- lang_ru;; *);
=> nrel_authored:
	kang_youwei;
=> nrel_introduces_category:
	great_unity;
	ren;
	de_virtue;;

