=> nrel_idtf:
	[Чжун Ю]
	(* <- lang_ru;; *);
	[Цзи Лу]
	(* <- lang_ru;; *);
=> nrel_note:
	[Цзы-Лу (542-480 до н. э.) - ученик воинственного нрава, погиб в междоусобице в царстве
	Вэй, по преданию - со словами о том, что нельзя умереть с развязанными завязками шапки,
	то есть нарушив ритуал.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
	state_wei;
=> nrel_lived_in_period:
	period_spring_autumn;
	dynasty_zhou;;

