	(* <- lang_ru;; *);
	[Жань Цзю]
	(* <- lang_ru;; *);
=> nrel_note:
	[Жань Цю (522-? до н. э.) служил главой дома Цзи в царстве Лу и организовал возвращение
	Конфуция из изгнания (484 г. до н. э.), при этом Конфуций упрекал его за помощь Цзи Сунь
	в чрезмерных поборах.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
=> nrel_lived_in_period:
	period_spring_autumn;;

