/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   Экземпляры: Мыслители раннего конфуцианства.
   Фактический слой - по открытым энциклопедическим источникам. */

confucius
<- concept_confucian_thinker;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
<- concept_confucian_official;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Конфуций]
	(* <- lang_ru;; *);
	[Confucius]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Кун Цю]
	(* <- lang_ru;; *);
	[Кун Чжун-ни]
	(* <- lang_ru;; *);
	[Учитель Кун]
	(* <- lang_ru;; *);
	[Кун-цзы]
	(* <- lang_ru;; *);
=> nrel_note:
	[Конфуций (551-479 до н. э.), имя Цю, второе имя Чжун-ни, происходил из царства Лу.
	Недолго занимал должности управляющего складаом, смотрителя пастбищ, а затем - министра
	общественных работ и министра юстиции царства Лу (около 500 г. до н. э.). Тринадцать лет
	странствовал по царствам, не получив применения своему учению, и вернулся в Лу, где
	занимался преподаванием и редактированием канонов.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
	state_qi;
	state_wei;
=> nrel_influenced:
	mencius;
	xunzi;
	zengzi;
	zisi;
	dong_zhongshu;
	han_yu;
	zhu_xi;
	yi_hwang;
	hayashi_razan;
=> nrel_lived_in_period:
	period_spring_autumn;
	dynasty_zhou;
=> nrel_teacher_of:
	yan_hui;
	zi_gong;
	zi_lu;
	zi_xia;
	zengzi;
	you_ruo;
	ran_qiu;;

mencius
<- concept_confucian_thinker;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Мэн-цзы]
	(* <- lang_ru;; *);
	[Mencius]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Мэн Кэ]
	(* <- lang_ru;; *);
	[Мэн-цзы]
	(* <- lang_ru;; *);
	[второй совершенномудрый после Конфуция]
	(* <- lang_ru;; *);
=> nrel_note:
	[Мэн-цзы (ок. 372-289 до н. э.) из царства Цзоу. По преданию, учился у последователей Цзы
	Сы, внука Конфуция. Странствовал по царствам Ци, Лян (Вэй) и Сун, убеждая правителей
	следовать «гуманному правлению» (жэнь чжэн). В эпоху Сун получил титул «второго
	совершенномудрого» (я шэн).]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_zou;
	state_qi;
	state_wei;
=> nrel_influenced:
	lu_jiuyuan;
	wang_yangming;
	dong_zhongshu;
=> nrel_lived_in_period:
	period_warring_states;
	dynasty_zhou;;

