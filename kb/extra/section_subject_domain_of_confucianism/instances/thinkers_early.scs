	(* <- lang_en;; *);
=> nrel_idtf:
	[Лао Дань]
	(* <- lang_ru;; *);
	[Ли Эр]
	(* <- lang_ru;; *);
=> nrel_note:
	[Полумифическая фигура, автор «Дао дэ цзина». В «Ши цзи» описана встреча Лао-цзы с
	Конфуцием, после которой Конфуций якобы сравнил его с драконом. Приведён здесь как
	представитель даосизма - учения, полемически значимого для конфуцианства.]
	(* <- lang_ru;; *);
