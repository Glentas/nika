<- concept_confucian_disciple;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
=> nrel_main_idtf:
	[Цзы-Ся]
	(* <- lang_ru;; *);
	[Zixia]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Бу Шан]
	(* <- lang_ru;; *);
=> nrel_note:
	[Цзы-Ся (род. 507 до н. э.) - ученик, с которым традиция связывает начало школы
	текстологического изучения канонов; после смерти Конфуция преподавал в царстве Вэй, в
	местности Си хэ. Ему приписывают ряд изречений «Лунь юй» о учении и о вэнь.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
	state_wei;
=> nrel_lived_in_period:
	period_spring_autumn;
	period_warring_states;;

