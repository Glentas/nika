	(* <- lang_en;; *);
=> nrel_idtf:
	[Ю-цзы]
	(* <- lang_ru;; *);
=> nrel_note:
	[Ю Жо (518-? до н. э.). Ему принадлежит открывающая «Лунь юй» связка мыслей: «Человек,
	который почтителен к родителям и уважителен к старшим братьям, редко склонен к мятежу»
	(1.2), где сяо и ди названы корнем жэнь.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
=> nrel_lived_in_period:
	period_spring_autumn;;

