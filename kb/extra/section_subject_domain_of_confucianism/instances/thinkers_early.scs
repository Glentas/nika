li_si
<- concept_east_asian_philosopher;
<- concept_chinese_philosopher;
=> nrel_main_idtf:
	[Ли Сы]
	(* <- lang_ru;; *);
	[Li Si]
	(* <- lang_en;; *);
=> nrel_note:
	[Ли Сы (ок. 280-208 до н. э.), ученик Сюнь-цзы, канцлер империи Цинь; инициировал в 213
	г. до н. э. сожжение книг, прежде всего «Ши цзина» и «Шу цзина», и казнь 460
	конфуцианцев, что стало травмой конфуцианской традиции.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_qin;
	empire_china;
=> nrel_lived_in_period:
	period_warring_states;
	dynasty_qin;;

