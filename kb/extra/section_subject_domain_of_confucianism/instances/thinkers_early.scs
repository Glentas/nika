	[Сюнь Куан]
	(* <- lang_ru;; *);
	[Сюнь Цин]
	(* <- lang_ru;; *);
=> nrel_note:
	[Сюнь-цзы (ок. 313-238 до н. э.) родом из царства Чжао, трижды занимал должность цзи цзю
	(старейшины учёных) в академии Цися царства Ци, позже был управляющим Ланьлином в
	царстве Чу. Его ученики Хань Фэй и Ли Сы стали легистами.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_zhao;
	state_qi;
	state_chu;
=> nrel_influenced:
	han_fei;
	li_si;
	dong_zhongshu;
=> nrel_lived_in_period:
	period_warring_states;
	dynasty_zhou;
=> nrel_teacher_of:
	han_fei;
	li_si;;

zengzi
<- concept_confucian_thinker;
<- concept_confucian_disciple;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_east_asian_philosopher;
=> nrel_main_idtf:
	[Цзэн-цзы]
	(* <- lang_ru;; *);
	[Zengzi]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Цзэн Шэнь]
	(* <- lang_ru;; *);
	[Цзэн Юй]
	(* <- lang_ru;; *);
=> nrel_note:
	[Цзэн Шэнь (505-435 до н. э.) - младший на 46 лет ученик Конфуция, славился сыновней
	почтительностью. Традиция связывает с ним «Да сюэ» и «Сяо цзин». В «Лунь юй» (1.4) ему
	принадлежит изречение о троекратной самопроверке.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
=> nrel_influenced:
	zisi;
	mencius;
=> nrel_lived_in_period:
	period_spring_autumn;
	dynasty_zhou;
=> nrel_teacher_of:
	zisi;;

zisi
<- concept_confucian_thinker;
<- concept_confucian_disciple;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
=> nrel_main_idtf:
	[Цзы-сы]
	(* <- lang_ru;; *);
	[Zisi]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Кун Цзи]
	(* <- lang_ru;; *);
=> nrel_note:
	[Цзы-сы (483-402 до н. э.), внук Конфуция; по преданию, ученик Цзэн-цзы и учитель
	Мэн-цзы. Традиция приписывает ему «Чжун юн». В 1993 г. в могильнике Годянь (Гуодянь)
	найдены бамбуковые тексты, связываемые с его школой.]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
=> nrel_influenced:
	mencius;
=> nrel_lived_in_period:
	period_spring_autumn;
	period_warring_states;
=> nrel_teacher_of:
	mencius;;

yan_hui
<- concept_confucian_disciple;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Янь Хуэй]
	(* <- lang_ru;; *);
	[Yan Hui]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Янь Юань]
	(* <- lang_ru;; *);
=> nrel_note:
	[Янь Хуэй (521-481 до н. э.) - любимый ученик Конфуция, образец бедности и постоянства в
	жэнь. В «Лунь юй» (6.11) Конфуций восклицает: «Каким достойным был Хуэй! Горсть риса,
	ковш воды, убогая лачуга - другие не вынесли бы такого горя, а Хуэй не терял радости».]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_lu;
=> nrel_lived_in_period:
	period_spring_autumn;
	dynasty_zhou;;

zi_gong
<- concept_confucian_disciple;
<- concept_person_of_confucian_tradition;
<- concept_chinese_philosopher;
=> nrel_main_idtf:
	[Цзы-Гун]
	(* <- lang_ru;; *);
	[Zigong]
	(* <- lang_en;; *);
=> nrel_idtf:
	[Дуаньму Сы]
	(* <- lang_ru;; *);
=> nrel_note:
	[Цзы-Гун (520-456 до н. э.) из царства Вэй - красноречивый ученик, ставший богатым купцом
	и дипломатом. Именно ему в «Лунь юй» (15.24) Конфуций излагает золотое правило: «Того,
	чего не желаешь себе, не делай другим».]
	(* <- lang_ru;; *);
=> nrel_associated_with_state:
	state_wei;
	state_lu;
	state_qi;
=> nrel_lived_in_period:
	period_spring_autumn;
	dynasty_zhou;;

