/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_temple - абсолютное понятие «храм Конфуция».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_temple
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[храм Конфуция]
	(* <- lang_ru;; *);
	[temple of Confucius]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_institution;
=> nrel_note:
	[Первый храм был основан на месте дома Конфуция в Цюйфу в 478 г. до н. э. (по преданию,
	по указу князя Лу). Храмы Конфуция (кун мяо, вэнь мяо) распространились по всему
	конфуцианскому миру - от Пекина и Нанкина до Сеула, Токио и Ханоя.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (храм Конфуция)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Храм Конфуция - культовое сооружение, посвящённое Конфуцию и
					использовавшееся для официальных церемоний и часто совмещавшееся с
					учебным заведением.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_institution
			};;
	*);;

