/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_lu_wang_school - абсолютное понятие «школа Лу - Ван».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_lu_wang_school
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[школа Лу - Ван]
	(* <- lang_ru;; *);
	[Lu-Wang school]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_neo_confucianism;
=> nrel_note:
	[Также «учение о сердце» (синь сюэ). Основана Лу Цзююанем, завершена Ван Янмином.
	Противостояла школе Чэн - Чжу: в 1175 г. на встрече у озера Эху Чжу Си и Лу Цзююань
	спорили о способе учения. Учение Ван Янмина о «врождённом знании» (лян чжи) и «единстве
	знания и действия» сильно повлияло на Корею и Японию.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (школа Лу - Ван)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Школа Лу - Ван - направление неоконфуцианства, полагающее первоначалом
					синь (сердце-сознание) и утверждающее единство знания и действия (чжи
					син хэ и).]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_neo_confucianism
			};;
	*);;

