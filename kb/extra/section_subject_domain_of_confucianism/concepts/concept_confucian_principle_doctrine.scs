/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_principle_doctrine - абсолютное понятие «положение конфуцианского учения».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_principle_doctrine
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[положение конфуцианского учения]
	(* <- lang_ru;; *);
	[principle of Confucian doctrine]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_concept;
=> nrel_inclusion:
	concept_confucian_self_cultivation_method;
=> nrel_note:
	[Положения учения - это те утверждения, по которым школы различаются и спорят между
	собой: золотое правило, исправление имён, мандат Неба, доброта или порочность природы,
	единство знания и действия.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (положение конфуцианского учения)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Положение конфуцианского учения - понятие конфуцианской традиции,
					выражающее содержательный тезис, разделяемый школой и отличающий её от
					других школ.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_concept;
				concept_confucian_self_cultivation_method
			};;
	*);;

