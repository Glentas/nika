/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_commentary - абсолютное понятие «комментарий к конфуцианскому канону».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_commentary
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[комментарий к конфуцианскому канону]
	(* <- lang_ru;; *);
	[commentary on a Confucian classic]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_text;
=> nrel_note:
	[Комментаторская традиция (чжуань, чжу, чжан цзюй) - основной способ развития
	конфуцианства: новое учение почти всегда строилось как толкование канона. Ключевые
	памятники - комментарии Чжэн Сюаня и «Четырёхкнижие с комментариями и толкованиями» Чжу
	Си.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (комментарий к конфуцианскому канону)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Комментарий к конфуцианскому канону - конфуцианский текст, разъясняющий
					канон и фиксирующий его истолкование в рамках определённой школы.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_text
			};;
	*);;

