/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_category - абсолютное понятие «конфуцианская философская категория».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_category
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианская философская категория]
	(* <- lang_ru;; *);
	[Confucian philosophical category]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_concept;
=> nrel_inclusion:
	concept_confucian_cosmological_category;
	concept_confucian_anthropological_category;
=> nrel_note:
	[Категориальный аппарат конфуцианства сложился в основном в неоконфуцианстве, которое
	заимствовало часть понятий у даосизма и буддизма.]
	(* <- lang_ru;; *);
<= nrel_subdividing:
	...
	(*
		<- sc_node_tuple;;
		=> nrel_main_idtf:
			[по предметной отнесённости]
			(* <- lang_ru;; *);;
		-> concept_confucian_cosmological_category;;
		-> concept_confucian_anthropological_category;;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианская философская категория)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианская философская категория - понятие конфуцианской традиции,
					выражающее предельное основание мироздания либо человека.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_concept;
				concept_confucian_cosmological_category;
				concept_confucian_anthropological_category
			};;
	*);;

