/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_educational_institution - абсолютное понятие «конфуцианское учебное заведение».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_educational_institution
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианское учебное заведение]
	(* <- lang_ru;; *);
	[Confucian educational institution]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_institution;
=> nrel_note:
	[Государственная академия (Гоцзыцзянь, кукчхагам, сёгаку) и частные академии (шу юань),
	среди которых знамениты Юэлу, Байлудун, Интянь и Дунлинь. В академии Юэлу Чжу Си читал
	лекции в 1167 и 1194 гг.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианское учебное заведение)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианское учебное заведение - учреждение, где преподавались
					конфуцианские каноны и готовились кандидаты к имперским экзаменам.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_institution
			};;
	*);;

