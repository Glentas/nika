/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_thinker - абсолютное понятие «конфуцианский мыслитель».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_thinker
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианский мыслитель]
	(* <- lang_ru;; *);
	[Confucian thinker]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_person_of_confucian_tradition;
<= nrel_inclusion:
	concept_east_asian_philosopher;
=> nrel_note:
	[В классе представлены деятели всех этапов: Конфуций, Мэн-цзы, Сюнь-цзы, Дун Чжуншу, Хань
	Юй, Чжоу Дуньи, Чжан Цзай, братья Чэн, Чжу Си, Лу Цзююань, Ван Янмин, Ли Хван, Ли И,
	Хаяси Радзан, Накаэ Тодзю, Кан Ювэй.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианский мыслитель)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианский мыслитель - деятель конфуцианской традиции, внесший вклад
					в истолкование канона либо в построение собственно философской системы.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_person_of_confucian_tradition;
				concept_east_asian_philosopher
			};;
	*);;

