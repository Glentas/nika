/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_text - абсолютное понятие «конфуцианский текст».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_text
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианский текст]
	(* <- lang_ru;; *);
	[Confucian text]
	(* <- lang_en;; *);
=> nrel_inclusion:
	concept_confucian_canonical_book;
	concept_confucian_commentary;
	concept_confucian_recorded_saying;
	concept_confucian_treatise;
=> nrel_note:
	[Максимальный класс текстового слоя предметной области; первый домен отношений «входит в
	состав канонического собрания*», «вводит понятие*», «прокомментировано*», «используется
	на имперском экзамене*».]
	(* <- lang_ru;; *);
<= nrel_subdividing:
	...
	(*
		<- sc_node_tuple;;
		=> nrel_main_idtf:
			[по жанру и статусу текста]
			(* <- lang_ru;; *);;
		-> concept_confucian_canonical_book;;
		-> concept_confucian_commentary;;
		-> concept_confucian_recorded_saying;;
		-> concept_confucian_treatise;;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианский текст)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианский текст - письменный памятник конфуцианской традиции: канон,
					комментарий, запись бесед либо авторский трактат.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_canonical_book;
				concept_confucian_commentary;
				concept_confucian_recorded_saying;
				concept_confucian_treatise
			};;
	*);;

