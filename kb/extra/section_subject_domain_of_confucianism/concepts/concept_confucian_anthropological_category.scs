/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_anthropological_category - абсолютное понятие «антропологическая категория конфуцианства».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_anthropological_category
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[антропологическая категория конфуцианства]
	(* <- lang_ru;; *);
	[anthropological category of Confucianism]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_category;
=> nrel_note:
	[синь (сердце-сознание), син (природа человека), цин (чувства), мин (судьба,
	предопределение). Спор о том, добра ли природа человека (син) от рождения, разделил
	Мэн-цзы и Сюнь-цзы.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (антропологическая категория конфуцианства)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Антропологическая категория конфуцианства - конфуцианская философская
					категория, описывающая устройство человека и источник его
					нравственности.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_category
			};;
	*);;

