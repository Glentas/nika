/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_canon - абсолютное понятие «каноническое собрание».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_canon
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[каноническое собрание]
	(* <- lang_ru;; *);
	[canonical collection]
	(* <- lang_en;; *);
=> nrel_note:
	[Каноническое собрание - не текст, а комплект текстов, поэтому связывается с текстами
	отношением «входит в состав канонического собрания*», а не включением. Известны
	Пятикнижие (у цзин), Четырёхкнижие (сы шу) и Тринадцатикнижие (ши сань цзин).]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (каноническое собрание)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Каноническое собрание - закреплённый традицией комплект конфуцианских
					текстов, обязательный для изучения и сдачи имперских экзаменов.]
					(* <- lang_ru;; *);;
			*);;
	*);;

