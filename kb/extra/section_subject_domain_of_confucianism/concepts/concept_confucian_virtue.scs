/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_virtue - абсолютное понятие «конфуцианская добродетель».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_virtue
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианская добродетель]
	(* <- lang_ru;; *);
	[Confucian virtue]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_concept;
=> nrel_inclusion:
	concept_confucian_cardinal_virtue;
=> nrel_note:
	[Добродетели образуют ядро этики Конфуция; в «Лунь юй» жэнь упоминается более пятидесяти
	раз и каждый раз поясняется применительно к ситуации.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианская добродетель)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианская добродетель - понятие конфуцианской традиции, обозначающее
					устойчивое нравственное качество, которое человек культивирует в
					процессе самосовершенствования.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_concept;
				concept_confucian_cardinal_virtue
			};;
	*);;

