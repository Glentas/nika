/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_imperial_examination - абсолютное понятие «имперский экзамен».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_imperial_examination
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[имперский экзамен]
	(* <- lang_ru;; *);
	[imperial examination]
	(* <- lang_en;; *);
=> nrel_note:
	[Система кэцзюй действовала с 605 г. (династия Суй) до 1905 г. С 1313 г. (династия Юань)
	экзаменационной программой стало «Четырёхкнижие» с комментариями Чжу Си, что закрепило
	школу Чэн - Чжу как ортодоксию.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (имперский экзамен)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Имперский экзамен - ступень системы кэцзюй, успешное прохождение которой
					давало учёную степень и право на чиновничью должность.]
					(* <- lang_ru;; *);;
			*);;
	*);;

