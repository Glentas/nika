/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_person_type - абсолютное понятие «тип личности в конфуцианстве».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_person_type
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[тип личности в конфуцианстве]
	(* <- lang_ru;; *);
	[Confucian type of personality]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_concept;
=> nrel_note:
	[Конфуцианство оценивает человека не по происхождению, а по степени нравственной
	зрелости, отсюда парные типы: цзюнь-цзы (благородный муж) и сяо жэнь (малый человек), а
	также высший идеал - шэн жэнь (совершенномудрый).]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (тип личности в конфуцианстве)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Тип личности в конфуцианстве - понятие конфуцианской традиции,
					описывающее устойчивый нравственный облик человека.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_concept
			};;
	*);;

