/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_legalism - абсолютное понятие «легизм».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_legalism
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[легизм]
	(* <- lang_ru;; *);
	[Legalism]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_philosophical_teaching;
=> nrel_note:
	[Школа законников (фа цзя): Шан Ян, Хань Фэй, Ли Сы. Противопоставляла конфуцианскому
	управлению через добродетель и ритуал управление через закон, награду и наказание.
	Сюнь-цзы, конфуцианец, был учителем Хань Фэя и Ли Сы, что показывает взаимное
	пересечение школ.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (легизм)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Легизм - философское учение, полагающее основой государственного порядка
					писаный закон (фа) и систему наказаний и наград, а не личную добродетель
					правителя.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_philosophical_teaching
			};;
	*);;

