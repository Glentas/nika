/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_east_asian_philosopher - абсолютное понятие «восточноазиатский философ».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_east_asian_philosopher
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[восточноазиатский философ]
	(* <- lang_ru;; *);
	[East Asian philosopher]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_person_of_east_asian_tradition;
=> nrel_inclusion:
	concept_chinese_philosopher;
	concept_confucian_thinker;
=> nrel_note:
	[Внешний класс: объединяет мыслителей Китая, Кореи и Японии, что позволяет корректно
	отнести к конфуцианским мыслителям Ли Хвана, Ли И, Хаяси Радзана и Накаэ Тодзю, не
	являвшихся китайцами.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (восточноазиатский философ)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Восточноазиатский философ - мыслитель, принадлежавший книжной традиции
					Китая, Кореи, Японии или Вьетнама.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_person_of_east_asian_tradition;
				concept_chinese_philosopher;
				concept_confucian_thinker
			};;
	*);;

