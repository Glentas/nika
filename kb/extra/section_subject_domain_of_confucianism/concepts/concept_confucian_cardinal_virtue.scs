/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_cardinal_virtue - абсолютное понятие «постоянство (у чан)».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_cardinal_virtue
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[постоянство (у чан)]
	(* <- lang_ru;; *);
	[constant virtue]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_virtue;
=> nrel_note:
	[Пять постоянств (у чан) - жэнь, и, ли, чжи, синь - были канонизированы Дун Чжуншу в
	эпоху Хань и вошли в формулу «три устоя и пять постоянств» (сань ган у чан).]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (постоянство (у чан))]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Постоянство - конфуцианская добродетель, входящая в канонический
					перечень пяти постоянств (у чан) и потому признаваемая неизменной нормой
					поведения во все эпохи.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_virtue
			};;
	*);;

