/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_chinese_dynasty - абсолютное понятие «китайская династия».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_chinese_dynasty
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[китайская династия]
	(* <- lang_ru;; *);
	[Chinese dynasty]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_historical_period;
=> nrel_note:
	[Династия - исторический период, совпадающий с правлением одной императорской фамилии; в
	китайской традиции летоисчисление велось по девизам правления и династиям.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (китайская династия)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Китайская династия - исторический период правления одной императорской
					фамилии в Китае.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_historical_period
			};;
	*);;

