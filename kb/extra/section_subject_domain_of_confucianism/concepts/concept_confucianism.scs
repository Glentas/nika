/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucianism - абсолютное понятие «конфуцианство».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucianism
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианство]
	(* <- lang_ru;; *);
	[Confucianism]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_philosophical_teaching;
=> nrel_inclusion:
	concept_confucian_school;
=> nrel_note:
	[МАКСИМАЛЬНЫЙ КЛАСС ОБЪЕКТОВ ИССЛЕДОВАНИЯ данной предметной области. Конфуцианство (жу
	цзя, «школа книжников») возникло в Китае в VI-V вв. до н. э. из проповеди Конфуция и
	развивалось его последователями на протяжении более двух тысяч лет. Фактический слой
	построен по открытым энциклопедическим источникам (статьи «Confucianism», «Confucius»,
	«Neo-Confucianism», «Four Books», «Five Classics» энциклопедий Wikipedia и БРЭ).]
	(* <- lang_ru;; *);
<= nrel_subdividing:
	...
	(*
		<- sc_node_tuple;;
		=> nrel_main_idtf:
			[по историческому этапу развития]
			(* <- lang_ru;; *);;
		-> concept_early_confucianism;;
		-> concept_han_confucianism;;
		-> concept_neo_confucianism;;
	*);
<= nrel_subdividing:
	...
	(*
		<- sc_node_tuple;;
		=> nrel_main_idtf:
			[по региону распространения в Восточной Азии]
			(* <- lang_ru;; *);;
		-> concept_korean_confucianism;;
		-> concept_japanese_confucianism;;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианство)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианство - философское учение, в центре которого находятся
					нравственное самосовершенствование человека, упорядочение семейных и
					государственных отношений средствами ритуала (ли) и человеколюбия
					(жэнь), а также опора на канонический корпус классических текстов.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_philosophical_teaching;
				concept_confucian_school
			};;
	*);;

