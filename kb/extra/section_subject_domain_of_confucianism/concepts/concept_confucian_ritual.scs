/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_ritual - абсолютное понятие «конфуцианский ритуал».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_ritual
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианский ритуал]
	(* <- lang_ru;; *);
	[Confucian ritual]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_concept;
=> nrel_note:
	[Ритуал (ли) - не обрядовая формальность, а способ упорядочивания отношений. Классический
	перечень церемоний зафиксирован в канонах «И ли» и «Ли цзи»; обычно выделяют обряд
	совершеннолетия (гуань ли), свадьбу (хунь ли), похороны (сан ли) и жертвоприношения (цзи
	ли).]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианский ритуал)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианский ритуал - понятие конфуцианской традиции, обозначающее
					нормативную церемонию, исполнение которой формирует и поддерживает
					социальные отношения.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_concept
			};;
	*);;

