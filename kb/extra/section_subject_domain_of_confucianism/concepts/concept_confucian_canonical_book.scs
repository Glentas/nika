/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_canonical_book - абсолютное понятие «конфуцианский канон».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_canonical_book
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианский канон]
	(* <- lang_ru;; *);
	[Confucian classic]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_text;
=> nrel_note:
	[Канон (цзин) - текст, официально признанный нормативным. Пятикнижие получило статус при
	Хань, Четырёхкнижие - после Чжу Си, Тринадцатикнижие сложилось к эпохе Сун.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианский канон)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианский канон - конфуцианский текст, включённый в состав
					официального канонического собрания.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_text
			};;
	*);;

