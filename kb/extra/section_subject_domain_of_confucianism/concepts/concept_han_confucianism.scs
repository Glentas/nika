/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_han_confucianism - абсолютное понятие «ханьское конфуцианство».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_han_confucianism
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[ханьское конфуцианство]
	(* <- lang_ru;; *);
	[Han Confucianism]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_school;
=> nrel_note:
	[Конфуцианство эпохи Хань (206 до н. э. - 220 н. э.). После доклада Дун Чжуншу императору
	У-ди (136 г. до н. э.) конфуцианство становится государственной идеологией; характерны
	космологизация учения и теория взаимодействия Неба и человека (тянь жэнь гань ин).]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (ханьское конфуцианство)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Ханьское конфуцианство - направление конфуцианства, развивавшееся в
					период династии Хань и соединившее этику Конфуция с космологией
					коррелятивного типа и теорией мандата Неба.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_school
			};;
	*);;

