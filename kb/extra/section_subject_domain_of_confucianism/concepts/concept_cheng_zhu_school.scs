/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_cheng_zhu_school - абсолютное понятие «школа Чэн - Чжу».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_cheng_zhu_school
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[школа Чэн - Чжу]
	(* <- lang_ru;; *);
	[Cheng-Zhu school]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_neo_confucianism;
=> nrel_note:
	[Также «учение о принципе» (ли сюэ). Ведёт линию от Чжоу Дуньи через братьев Чэн к Чжу
	Си. С 1313 г. толкования Чжу Си стали обязательной основой имперских экзаменов кэцзюй и
	оставались ею до 1905 г.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (школа Чэн - Чжу)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Школа Чэн - Чжу - направление неоконфуцианства, полагающее первоначалом
					ли (принцип) и предписывающее путь «исследования вещей ради обретения
					знания» (гэ у чжи).]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_neo_confucianism
			};;
	*);;

