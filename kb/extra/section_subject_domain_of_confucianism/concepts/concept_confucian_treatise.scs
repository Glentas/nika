/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_treatise - абсолютное понятие «конфуцианский трактат».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_treatise
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианский трактат]
	(* <- lang_ru;; *);
	[Confucian treatise]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_text;
=> nrel_note:
	[Авторские сочинения: «Сюнь-цзы», «Тайцзи ту шу» Чжоу Дуньи, «Си мин» Чжан Цзая, «Чуньцю
	фаньлу» Дун Чжуншу, «Цзинь сы лу» Чжу Си и Люй Цзуцяня.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианский трактат)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианский трактат - авторский конфуцианский текст, излагающий
					систему взглядов мыслителя, а не толкующий канон построчно.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_text
			};;
	*);;

