/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_buddhism - абсолютное понятие «буддизм».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_buddhism
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[буддизм]
	(* <- lang_ru;; *);
	[Buddhism]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_philosophical_teaching;
=> nrel_note:
	[Проник в Китай в I в. н. э.; в эпоху Тан стал главным мировоззренческим соперником
	конфуцианства. Хань Юй в 819 г. подал императору «Поминание о кости Будды» с требованием
	ограничить буддизм. Метафизика буддизма (чань) оказала заметное влияние на формирование
	неоконфуцианства.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (буддизм)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Буддизм - религиозно-философское учение индийского происхождения,
					основанное на понятиях страдания, непостоянства и освобождения
					(нирваны).]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_philosophical_teaching
			};;
	*);;

