/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_early_confucianism - абсолютное понятие «раннее конфуцианство».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_early_confucianism
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[раннее конфуцианство]
	(* <- lang_ru;; *);
	[early Confucianism]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_confucian_school;
=> nrel_note:
	[Охватывает учение Конфуция и его развитие Мэн-цзы и Сюнь-цзы в эпохи Чуньцю (Вёсны и
	Осени, 770-476 до н. э.) и Чжаньго (Воюющие царства, 475-221 до н. э.).]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (раннее конфуцианство)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Раннее конфуцианство - направление конфуцианства, сформировавшееся до
					превращения учения в государственную идеологию империи Хань, то есть в
					период с VI по III в. до н. э.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_confucian_school
			};;
	*);;

