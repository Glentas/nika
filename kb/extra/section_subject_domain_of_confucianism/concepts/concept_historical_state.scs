/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_historical_state - абсолютное понятие «историческое государство».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_historical_state
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[историческое государство]
	(* <- lang_ru;; *);
	[historical state]
	(* <- lang_en;; *);
=> nrel_note:
	[Второй домен отношений «связан с государством*» и «распространено в*». Включает как
	удельные царства эпохи Чуньцю и Чжаньго (Лу, Ци, Цинь, Чу), так и имперские образования
	- Китай, Корею Чосон, Японию Токугава, Вьетнам.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (историческое государство)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Историческое государство - политическое образование Восточной Азии, в
					котором распространялось и применялось конфуцианство.]
					(* <- lang_ru;; *);;
			*);;
	*);;

