/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_confucian_official - абсолютное понятие «конфуцианский чиновник».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_confucian_official
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[конфуцианский чиновник]
	(* <- lang_ru;; *);
	[Confucian official]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_person_of_confucian_tradition;
=> nrel_note:
	[Конфуцианство предполагало, что учёный (ши) обязан служить государству; многие мыслители
	совмещали философскую работу со службой. Класс продемонстрирован на Дун Чжуншу, Фань
	Чжунъяне, Сыма Гуане, Ван Аньши, Чжу Си и Хай Жуе.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (конфуцианский чиновник)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Конфуцианский чиновник - деятель конфуцианской традиции, занимавший
					должность в системе государственного управления имперского Китая, Кореи
					или Японии.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_person_of_confucian_tradition
			};;
	*);;

