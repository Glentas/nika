/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_daoism - абсолютное понятие «даосизм».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_daoism
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[даосизм]
	(* <- lang_ru;; *);
	[Daoism]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_philosophical_teaching;
=> nrel_note:
	[Учение, связанное с именами Лао-цзы и Чжуан-цзы. Конфуцианство полемизировало с
	даосизмом по вопросу о соотношении ритуала (ли) и естественности (цзы жань).]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (даосизм)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Даосизм - философское учение, первоначалом которого выступает дао
					(путь), а идеалом поведения - недеяние (у вэй) и следование
					естественности.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_philosophical_teaching
			};;
	*);;

