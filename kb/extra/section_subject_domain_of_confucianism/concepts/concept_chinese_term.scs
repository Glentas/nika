/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   concept_chinese_term - абсолютное понятие «китайский термин».
   Фактический слой - по открытым энциклопедическим источникам. */

concept_chinese_term
<- sc_node_class;
<- class;
=> nrel_main_idtf:
	[китайский термин]
	(* <- lang_ru;; *);
	[Chinese term]
	(* <- lang_en;; *);
=> nrel_note:
	[Знаки китайского письма хранятся отдельными sc-ссылками и связываются с понятиями
	отношением «китайский термин*», чтобы не смешивать основной русский идентификатор
	понятия с его иноязычным соответствием.]
	(* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (китайский термин)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
		...
			(*
				-> rrel_example:
					[Китайский термин - письменное обозначение понятия конфуцианской традиции
					средствами китайского письма.]
					(* <- lang_ru;; *);;
			*);;
	*);;

