/* База знаний системы NIKA. ЛР №3 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   Классы ответных сообщений и классы фраз для правил ответа ЛР №3. */

concept_message_about_confucian_person
<- sc_node_class;
=> nrel_main_idtf:
	[сообщение о персоне конфуцианской традиции]
	(* <- lang_ru;; *);
	[message about a person of the Confucian tradition]
	(* <- lang_en;; *);
=> nrel_note:
	[Сообщение о персоне конфуцианской традиции - атомарное сообщение о сущности, выделенная сущность которого принадлежит классу персоналий конфуцианской традиции.]
	(* <- lang_ru;; *);;

concept_message_about_confucian_text
<- sc_node_class;
=> nrel_main_idtf:
	[сообщение о конфуцианском тексте]
	(* <- lang_ru;; *);
	[message about a Confucian text]
	(* <- lang_en;; *);
=> nrel_note:
	[Сообщение о конфуцианском тексте - атомарное сообщение о сущности, выделенная сущность которого принадлежит классу конфуцианских текстов.]
	(* <- lang_ru;; *);;

