concept_phrase_about_confucian_person
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о персоне конфуцианской традиции]
	(* <- lang_ru;; *);
	[phrase about a person of the Confucian tradition]
	(* <- lang_en;; *);
=> nrel_note:
	[Фраза о персоне конфуцианской традиции - фраза, содержащая сведения о персоне конфуцианской традиции: имя, время жизни, влияние, примечание.]
	(* <- lang_ru;; *);;

