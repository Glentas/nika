	(* <- lang_ru;; *);
	[phrase about a Confucian text]
	(* <- lang_en;; *);
=> nrel_note:
	[Фраза о конфуцианском тексте - фраза, содержащая сведения о конфуцианском тексте: название, принадлежность канону, место изучения, примечание.]
	(* <- lang_ru;; *);;

