/* База знаний системы NIKA. ЛР №1 дисциплины ТиИСПИС.
   Вариант №130: Конфуцианство. Каталог section_subject_domain_of_confucianism
   копируется в nika/kb/extra/ (ветка tpis-2023).
   Схема предметной области: максимальный класс объектов исследования, немаксимальные
   классы и исследуемые отношения.
   Фактический слой - по открытым энциклопедическим источникам. */

section_subject_domain_of_confucianism
=> nrel_main_idtf:
	[Раздел. Предметная область конфуцианства]
	(* <- lang_ru;; *);
	[Section. Subject domain of Confucianism]
	(* <- lang_en;; *);
<- atomic_section;;

section_subject_domain_of_confucianism = [*
	subject_domain_of_confucianism
	<- sc_node_struct;
	=> nrel_main_idtf:
